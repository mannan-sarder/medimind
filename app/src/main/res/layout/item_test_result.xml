<?xml version="1.0" encoding="utf-8"?>
<!--
    One test-result card in the Result screen.

    CHANGES FROM ORIGINAL
    ─────────────────────
    New views added to match ResultFragment's full-discussion requirement:

      tvTestNameBn      – Bangla name of the test (e.g. "মোট শ্বেত রক্তকণিকা")
                          Hidden when Bangla name equals the English name or is null.

      tvQuestionsLabel  – "Questions to ask your doctor:" heading
                          Hidden when there are no doctor questions (normal results).

      tvQuestions       – Numbered list of doctor questions from the dataset.
                          Hidden when status is Normal or test is Unknown.

      tvReferencesLabel – "References:" heading
                          Hidden when the test has no references in the dataset.

      tvReferences      – Bulleted list of citation strings from the dataset.

    All existing view IDs (tvTestName, tvTestValue, tvStatus, tvReferenceRange,
    tvExplanation) are preserved unchanged.
-->
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/background_white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Row 1: English test name (left) + value (right) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- English test name, bold -->
            <TextView
                android:id="@+id/tvTestName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:fontFamily="@font/inter"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/colorPrimary" />

            <!-- Numeric value + unit (right-aligned) -->
            <TextView
                android:id="@+id/tvTestValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/colorPrimary" />
        </LinearLayout>

        <!-- Bangla test name (hidden when not applicable) -->
        <TextView
            android:id="@+id/tvTestNameBn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/inter"
            android:textSize="12sp"
            android:textColor="@color/colorAccentMuted"
            android:visibility="gone" />

        <!-- Status badge (colour set programmatically by ResultFragment) -->
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:fontFamily="@font/inter"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/status_badge_bg" />

        <!-- Reference range -->
        <TextView
            android:id="@+id/tvReferenceRange"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/inter"
            android:textSize="12sp"
            android:textColor="@color/range_text"
            android:visibility="gone" />

        <!-- Thin divider before explanation -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="8dp"
            android:background="@color/border_light" />

        <!-- Explanation text from dataset (explanation_normal/low/high_en|bn) -->
        <TextView
            android:id="@+id/tvExplanation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter"
            android:textSize="13sp"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/instruction_grey" />

        <!-- Questions to ask your doctor (label, hidden for normal results) -->
        <TextView
            android:id="@+id/tvQuestionsLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/inter"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/colorPrimary"
            android:text="Questions to ask your doctor:"
            android:visibility="gone" />

        <!-- Numbered question list (hidden for normal results) -->
        <TextView
            android:id="@+id/tvQuestions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/inter"
            android:textSize="13sp"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/instruction_grey"
            android:visibility="gone" />

        <!-- References label (hidden when dataset has no references) -->
        <TextView
            android:id="@+id/tvReferencesLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/inter"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/colorAccentMuted"
            android:text="References:"
            android:visibility="gone" />

        <!-- Bulleted citation list (hidden when dataset has no references) -->
        <TextView
            android:id="@+id/tvReferences"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/inter"
            android:textSize="11sp"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/colorAccentMuted"
            android:visibility="gone" />

    </LinearLayout>
</androidx.cardview.widget.CardView>
