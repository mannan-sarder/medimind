<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_white"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Title -->
        <TextView
            android:id="@+id/tvCompareTitle"
            style="@style/TextAppearance.Medimind.TitleMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp"
            android:text="Compare Reports"
            android:textAlignment="center" />

        <!-- Subtitle -->
        <TextView
            android:id="@+id/tvCompareSubtitle"
            style="@style/TextAppearance.Medimind.Subtle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="4dp"
            android:text="একই রোগীর দুটি রিপোর্ট বাছাই করুন"
            android:textAlignment="center" />

        <!-- Language Selection Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardLanguageCompare"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="@color/card_blue_tint"
            app:cardCornerRadius="12dp"
            app:cardElevation="1dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ভাষা / Language"
                    android:textColor="@color/colorPrimary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <RadioGroup
                    android:id="@+id/rgLanguageCompare"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rbCompareBangla"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="24dp"
                        android:checked="true"
                        android:text="বাংলা"
                        android:textColor="@color/colorPrimary"
                        android:textSize="14sp" />

                    <RadioButton
                        android:id="@+id/rbCompareEnglish"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="false"
                        android:text="English"
                        android:textColor="@color/colorPrimary"
                        android:textSize="14sp" />

                </RadioGroup>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Report selection row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <!-- Report 1 card -->
            <LinearLayout
                android:id="@+id/cardReport1"
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="10dp"
                android:background="@drawable/sheet_option_bg"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    style="@style/TextAppearance.Medimind.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📋  Report 1"
                    android:textColor="@color/colorPrimary"
                    android:textStyle="bold"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvSelectedReport1"
                    style="@style/TextAppearance.Medimind.Subtle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="ট্যাপ করুন"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:gravity="center" />
            </LinearLayout>

            <!-- Report 2 card -->
            <LinearLayout
                android:id="@+id/cardReport2"
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="10dp"
                android:background="@drawable/sheet_option_bg"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    style="@style/TextAppearance.Medimind.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📋  Report 2"
                    android:textColor="@color/colorPrimary"
                    android:textStyle="bold"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvSelectedReport2"
                    style="@style/TextAppearance.Medimind.Subtle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="ট্যাপ করুন"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:gravity="center" />
            </LinearLayout>
        </LinearLayout>

        <!-- Compare Button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnCompare"
            style="@style/Widget.Medimind.Button"
            android:layout_width="180dp"
            android:layout_height="44dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp"
            android:background="@drawable/button_primary"
            android:text="Compare"
            android:textColor="@android:color/white" />

        <!-- Progress Indicator -->
        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/progressBarCompare"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:indeterminate="true"
            android:visibility="gone"
            app:indicatorColor="@color/colorAccent"
            app:indicatorSize="40dp"
            app:trackThickness="4dp" />

        <!-- Results Container — full height, no clipping -->
        <LinearLayout
            android:id="@+id/layoutResultsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="32dp">

            <TextView
                android:id="@+id/tvResultPlaceholder"
                style="@style/TextAppearance.Medimind.Subtle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:text="দুটি রিপোর্ট বাছাই করে Compare বোতাম চাপুন।" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
