<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/background_white"
    android:paddingTop="8dp"
    android:paddingBottom="32dp"
    android:paddingStart="24dp"
    android:paddingEnd="24dp">

    <!-- Drag handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="20dp"
        android:background="#CCCCCC" />

    <!-- Title -->
    <TextView
        style="@style/TextAppearance.Medimind.TitleMedium"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="রিপোর্ট যোগ করুন"
        android:textSize="18sp"
        android:layout_marginBottom="20dp" />

    <!-- Option 1: Open Camera -->
    <LinearLayout
        android:id="@+id/btnSheetCamera"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginBottom="10dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:background="@drawable/sheet_option_bg"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:text="📷"
            android:textSize="22sp"
            android:gravity="center" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="16dp">

            <TextView
                style="@style/TextAppearance.Medimind.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Open Camera"
                android:textStyle="bold"
                android:textColor="@color/colorPrimary" />

            <TextView
                style="@style/TextAppearance.Medimind.Subtle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="এখনই ছবি তুলে analyze করো"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="›"
            android:textSize="22sp"
            android:textColor="@color/colorPrimary" />
    </LinearLayout>

    <!-- Option 2: Choose from Device -->
    <LinearLayout
        android:id="@+id/btnSheetGallery"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginBottom="10dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:background="@drawable/sheet_option_bg"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:text="🖼️"
            android:textSize="22sp"
            android:gravity="center" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="16dp">

            <TextView
                style="@style/TextAppearance.Medimind.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Choose from Device"
                android:textStyle="bold"
                android:textColor="@color/colorPrimary" />

            <TextView
                style="@style/TextAppearance.Medimind.Subtle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="গ্যালারি থেকে ছবি বাছাই করো"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="›"
            android:textSize="22sp"
            android:textColor="@color/colorPrimary" />
    </LinearLayout>

    <!-- Option 3: Select from History -->
    <LinearLayout
        android:id="@+id/btnSheetHistory"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:background="@drawable/sheet_option_bg"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:text="🗂️"
            android:textSize="22sp"
            android:gravity="center" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="16dp">

            <TextView
                style="@style/TextAppearance.Medimind.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Select from History"
                android:textStyle="bold"
                android:textColor="@color/colorPrimary" />

            <TextView
                style="@style/TextAppearance.Medimind.Subtle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="আগে সেভ করা রিপোর্ট থেকে বেছে নাও"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="›"
            android:textSize="22sp"
            android:textColor="@color/colorPrimary" />
    </LinearLayout>

</LinearLayout>
