<?xml version="1.0" encoding="utf-8"?>
<!--
    Analyze screen layout.

    CHANGES FROM ORIGINAL
    ─────────────────────
    1. SPINNER VISIBILITY FIX:
       The original XML had android:visibility="visible" on cardProcessing,
       so the spinner was always on screen even before the user picked an image.
       Changed to android:visibility="gone" – Java code shows it the moment
       scanning begins and hides it before navigating away.

    2. LANGUAGE SELECTION (Bangla default):
       Added a RadioGroup (rgLanguage) with two RadioButtons:
         • rbBangla  – "বাংলা"  (pre-checked, the default)
         • rbEnglish – "English"
       Positioned between the title and the upload buttons so the user sees
       and sets their language preference before initiating a scan.
       AnalyzeFragment reads the checked state and passes the language code
       to ReportAnalyzer so explanations are in the correct language.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_white"
    android:padding="24dp">

    <!-- Screen title -->
    <TextView
        android:id="@+id/tvAnalyzeTitle"
        style="@style/TextAppearance.Medimind.TitleLarge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="60dp"
        android:text="Upload Your Test Report"
        android:textAlignment="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- ── LANGUAGE SELECTION ──────────────────────────────────────────── -->
    <!-- A small card housing the RadioGroup keeps it visually grouped.    -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardLanguage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        app:cardBackgroundColor="@color/card_blue_tint"
        app:cardCornerRadius="12dp"
        app:cardElevation="1dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvAnalyzeTitle">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Select Report Language / ভাষা নির্বাচন করুন"
                android:textColor="@color/colorPrimary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFamily="@font/inter"
                android:layout_marginBottom="8dp" />

            <!--
                RadioGroup – AnalyzeFragment reads the checked button id.
                rbBangla is checked by default (matches selectedLanguage = LANG_BN).
            -->
            <RadioGroup
                android:id="@+id/rgLanguage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Bangla option (default) -->
                <RadioButton
                    android:id="@+id/rbBangla"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="24dp"
                    android:checked="true"
                    android:fontFamily="@font/inter"
                    android:text="বাংলা"
                    android:textColor="@color/colorPrimary"
                    android:textSize="14sp" />

                <!-- English option -->
                <RadioButton
                    android:id="@+id/rbEnglish"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="false"
                    android:fontFamily="@font/inter"
                    android:text="English"
                    android:textColor="@color/colorPrimary"
                    android:textSize="14sp" />

            </RadioGroup>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
    <!-- ── END LANGUAGE SELECTION ─────────────────────────────────────── -->

    <!-- Open Camera button -->
    <Button
        android:id="@+id/btnOpenCamera"
        style="@style/Widget.Medimind.Button"
        android:layout_width="200dp"
        android:layout_height="50dp"
        android:layout_marginTop="28dp"
        android:text="Open Camera"
        android:textColor="@color/text_white"
        app:backgroundTint="@color/colorAccent"
        app:cornerRadius="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cardLanguage" />

    <!-- Choose from Gallery button -->
    <Button
        android:id="@+id/btnChooseGallery"
        style="@style/Widget.Medimind.Button"
        android:layout_width="300dp"
        android:layout_height="50dp"
        android:layout_marginTop="10dp"
        android:text="Choose from Device"
        android:textColor="@color/text_white"
        app:backgroundTint="@color/colorAccent"
        app:cornerRadius="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnOpenCamera" />

    <!--
        Processing spinner card.

        FIX: was android:visibility="visible" in the original, so the spinner
        appeared immediately on screen before any image was chosen.
        Corrected to android:visibility="gone" – the Java code calls
        cardProcessing.setVisibility(View.VISIBLE) the instant scanning begins
        and setVisibility(View.GONE) right before navigating away.
    -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardProcessing"
        android:layout_width="360dp"
        android:layout_height="220dp"
        android:layout_marginTop="24dp"
        android:visibility="gone"
        app:cardBackgroundColor="@color/card_blue_tint"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnChooseGallery">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:indeterminate="true"
                app:indeterminateAnimationType="contiguous"
                app:indicatorColor="@color/colorAccent"
                app:indicatorSize="52dp"
                app:trackThickness="5dp" />

            <TextView
                android:id="@+id/tvProcessingTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/inter"
                android:text="Processing your report..."
                android:textColor="@color/colorPrimary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvProcessingSteps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/inter"
                android:gravity="center"
                android:text="Extracting text → Analysing → Generating results"
                android:textColor="@color/text_light"
                android:textSize="12sp" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
