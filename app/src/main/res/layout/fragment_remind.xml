<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_white">

    <!-- Header: Title -->
    <TextView
        android:id="@+id/tvReminderTitle"
        style="@style/TextAppearance.Medimind.TitleMedium"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Reminders"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Add Button (+) - No drawable, using solid text color -->
    <TextView
        android:id="@+id/btnAddReminder"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:text="+"
        android:textSize="28sp"
        android:textColor="@color/colorAccent"
        android:gravity="center"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Add new reminder"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="@+id/tvReminderTitle"
        app:layout_constraintVertical_bias="0.5" />

    <!-- Divider Line -->
    <View
        android:id="@+id/divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border_light"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@+id/tvReminderTitle" />

    <!-- RecyclerView for Reminders -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvRemindList"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:clipToPadding="false"
        android:paddingBottom="16dp"
        app:layout_constraintTop_toBottomOf="@+id/divider"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:scrollbars="vertical" />

    <!-- Empty State Message -->
    <TextView
        android:id="@+id/tvEmptyMessage"
        style="@style/TextAppearance.Medimind.Subtle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="No reminders set yet.\nTap + to add."
        android:gravity="center"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>