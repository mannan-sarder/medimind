<?xml version="1.0" encoding="utf-8"?>
<!--
    Exclude only SharedPreferences from cloud backup and device transfer.
    Room database (history/reports) is kept in backup intentionally.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="MediMindPrefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="MediMindPrefs.xml" />
    </device-transfer>
</data-extraction-rules>
